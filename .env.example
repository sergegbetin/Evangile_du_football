# Auth (Dashboard > Authentication > URL Configuration)
# Local:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Production (required for password reset + magic links):
#   Site URL: https://your-domain.example
#   Redirect URLs: https://your-domain.example/auth/callback
# Direct link (this project):
#   https://supabase.com/dashboard/project/vbqqbxfcigacawiuuowi/auth/url-configuration

# Optional: overrides the origin used to build password-reset redirect links.
# Falls back to the request Host header if unset (recommended for local dev).
# Set this in production to your public origin.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
